{
  "name": "aernyth",
  "version": "0.2.1",
  "description": "On-chain delivery receipts for paid API calls on Arc: the provider commits, irrevocably, to the exact bytes it returned for a payment.",
  "keywords": [
    "arc",
    "x402",
    "usdc",
    "circle",
    "receipts",
    "eip-712",
    "merkle",
    "micropayments",
    "agents"
  ],
  "homepage": "https://aernyth.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kendu3310/arcproof.git",
    "directory": "packages/aernyth"
  },
  "bugs": {
    "url": "https://github.com/kendu3310/arcproof/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./networks": {
      "types": "./dist/networks.d.ts",
      "default": "./dist/networks.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "viem": "^2.47.1"
  },
  "peerDependencies": {
    "@types/express": "^5.0.0",
    "express": "^5.2.1"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "@types/express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@circle-fin/x402-batching": "^3.5.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@x402/core": "^2.28.0",
    "typescript": "^5.7.0"
  }
}
