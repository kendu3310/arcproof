# Copy this file to `.env` and fill it in. `.env` is gitignored; this file is not.
# Never put a real key in this file.

# Which Arc network to talk to: `arcTestnet` while building, `arc` for mainnet.
# The microgrant requires a mainnet deployment — testnet-only builds are not
# eligible — but develop on testnet and switch this one value at the end.
ARC_NETWORK=arcTestnet

# The wallet that signs ReceiptRegistry writes and pays their gas.
# Treat this as a hot key: it signs unattended inside the server process.
# Use a FRESH wallet holding only a few USDC, never your main one.
# Generate it with:  node scripts/new-wallet.mjs
PROVIDER_PRIVATE_KEY=

# The wallet that receives payments for served requests.
# Only the address is needed, never its key — so point this at a wallet whose
# key never touches this machine.
SELLER_ADDRESS=

# Filled in by scripts/deploy-registry.mjs, one per network. Kept separate so
# that switching ARC_NETWORK cannot leave the app reading receipts from an
# address that only exists on the other chain.
RECEIPT_REGISTRY_ADDRESS_ARC=
RECEIPT_REGISTRY_ADDRESS_ARCTESTNET=

# Local port for the example services.
PORT=3000
