{
  "name": "aernyth-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Verifiable deliverables for x402-paid services on Arc. Circle's SDK settles the payment; Aernyth proves what was delivered for it.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --test test/*.test.mjs && npm run test --workspaces --if-present",
    "start": "node --experimental-strip-types examples/glb-service/src/server.ts"
  },
  "devDependencies": {
    "js-sha3": "^0.13.0",
    "solc": "^0.8.37"
  }
}
