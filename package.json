{
  "name": "arcproof-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Verifiable deliverables for x402-paid services on Arc. Circle's SDK settles the payment; arcproof proves what was delivered for it.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
